# CorridorSync — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=false

# ── Database ─────────────────────────────────────────────────────────────────
# Provided automatically by Docker Compose.
# Override only if you are running outside Docker.
DATABASE_URL=postgresql://corridorsync:corridorsync@db:5432/corridorsync

# ── External Traffic Provider ────────────────────────────────────────────────
# Obtain a free key at: https://developer.here.com/
# Leave blank to run without live traffic data (synthetic fallback is used).
HERE_API_KEY=

# Set to "none" to force the OSRM / static fallback even when a key is present.
TRAFFIC_PROVIDER=here

# ── IBM watsonx Orchestrate ───────────────────────────────────────────────────
# Not used in Phase 1. Set these before integrating Orchestrate.
# ORCHESTRATE_INSTANCE_URL=
# ORCHESTRATE_API_KEY=
