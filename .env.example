# CorridorSync — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=false

# ── Database ─────────────────────────────────────────────────────────────────
# Provided automatically by Docker Compose.
# Override only if you are running outside Docker.
DATABASE_URL=postgresql://corridorsync:corridorsync@db:5432/corridorsync

# ── External Traffic Provider ────────────────────────────────────────────────
# Set to "demo" to use deterministic simulated data (default, no key needed).
# Set to "tomtom" to use live TomTom data (requires TOMTOM_API_KEY).
# Set to "none" in tests to always use simulated data.
TRAFFIC_PROVIDER=demo

# TomTom Traffic Flow API key
# Get a free key at: https://developer.tomtom.com/
# Leave blank to use simulated demo data instead.
TOMTOM_API_KEY=

# ── IBM watsonx Orchestrate ───────────────────────────────────────────────────
# Not used in Phase 1. Set these before integrating Orchestrate.
# ORCHESTRATE_INSTANCE_URL=
# ORCHESTRATE_API_KEY=
